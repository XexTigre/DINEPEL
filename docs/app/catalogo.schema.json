{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CatalogoDinepelV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "synthetic", "brands", "products"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "catalogo"},
    "synthetic": {"type": "boolean"},
    "brands": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/brand"}},
    "products": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/product"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "brand": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}}
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "brand_id", "code", "name", "unit", "status", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "brand_id": {"$ref": "#/$defs/text"},
        "code": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"},
        "unit": {"enum": ["UN", "PC", "KT"]},
        "status": {"enum": ["pendente", "revisado"]},
        "source": {"$ref": "#/$defs/text"}
      }
    }
  }
}
